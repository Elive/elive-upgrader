[Unit]
Description=Distro Upgrader
Documentation=man:debian-upgrader(8)
# Only run if the upgrade state file exists
ConditionPathExists=/etc/default/elive-distro-upgrade
# Ensure filesystems and network are ready before attempting upgrade
After=network.target local-fs.target syslog.target plymouth-start.service
# Prevent the graphical interface / login manager and TTY logins on tty1 from starting during the upgrade
Before=graphical.target display-manager.service plymouth-quit.service plymouth-quit-active.service getty.target getty@tty1.service
# Prevent running during shutdown/reboot to avoid conflicts, prevent display manager, and stop getty on tty1
Conflicts=shutdown.target reboot.target halt.target display-manager.service getty@tty1.service
# Don't run if the system is in emergency/rescue mode
ConditionPathExists=!/etc/default/elive-distro-upgrade-recovery

[Service]
Type=oneshot
ExecStart=/usr/lib/elive-upgrader/elive-boot-upgrader
ExecStopPost=-/bin/sh -c 'systemctl unmask getty@tty1.service 2>/dev/null || true'
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=yes
# No timeout - upgrade can take a long time
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

main(){
    if [[ "$1" = "--enable-distro-upgrade" ]] ; then
        /usr/lib/elive-upgrader/debian-upgrader --enable-boot-upgrade "$2"
        exit $?
    fi

    if [[ "$1" = "--cancel-distro-upgrade" ]] ; then
        /usr/lib/elive-upgrader/debian-upgrader --cancel
        exit $?
    fi

    if [[ "$1" = "--distro-upgrade-status" ]] ; then
        /usr/lib/elive-upgrader/debian-upgrader --status
        exit $?
    fi

    if [[ "$1" = "--clear-security-markers" ]] ; then
        el_debug "Clearing /var/run/elive-security markers"
        rm -f /var/run/elive-security/updated /var/run/elive-security/unpatched
        exit 0
    fi

    if [[ "$1" = "--security" ]] ; then
        shift
        el_debug "Delegating --security to /usr/sbin/elive-security $*"
        exec /usr/sbin/elive-security "$@"
    fi

    # pre {{{
    version_elive="$( cat "/etc/elive-version" | grep "elive-version:" | awk '{print $2}' )"
    read -r version_elive <<< "$version_elive"

    hooks_d="/usr/lib/elive-upgrader/hooks"

    # }}}
    # never run on live mode {{{
    # managed already from the main script
    #if grep -qs "boot=live" /proc/cmdline ; then
        #exit
    #fi

    # }}}

    el_config_get

    # options
    for arg in "$@"
    do
        case "$arg" in
            --noaptupdate|--no-aptupdate)
                is_update_ignored=1
                ;;
            --ping)
                echo "pong"
                exit
                ;;
            --force)
                is_force=1
                ;;
            --betatest)
                is_betatester=1
                touch /tmp/.elive-upgrader-betatest
                ;;
            --debug|-d)
                export EL_DEBUG=4
                is_print_fancy=1
                ;;
            --test|--dry-run)
                export ELIVE_UPGRADER_TEST=1
                export EL_DEBUG="${EL_DEBUG:-3}"
                is_print_fancy=1
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
        esac
    done

    el_debug "elive-upgrader-root starting: enabled=${ELIVE_UPGRADER_ENABLED:-yes}, force=${is_force:-0}, test=${ELIVE_UPGRADER_TEST:-0}, args='$*'"
    if [[ "${ELIVE_UPGRADER_ENABLED:-yes}" != "yes" ]] && ! ((is_force)) && ! ((ELIVE_UPGRADER_TEST)) ; then
        el_info "elive-upgrader is disabled in /etc/default/elive-upgrader (ELIVE_UPGRADER_ENABLED=no). Exiting."
        exit 0
    fi

    for arg in "$@"
    do
        case "$arg" in
            --update|--update-tool)
                el_debug "Dispatching action: $arg"
                update_upgrader_fast
                ;;
            --hooks-root-pre)
                el_debug "Dispatching action: $arg"
                hooks_root_pre
                ;;
            --hooks-root-post)
                el_debug "Dispatching action: $arg"
                hooks_root_post
                ;;
            --upgrade)
                el_debug "Dispatching action: $arg"
                upgrade_system
                ;;
            --updates-available)
                el_debug "Dispatching action: $arg"
                updates_available_show
                ;;
            --upgrade-firmwares|--upgrade-firmware)
                el_debug "Dispatching action: $arg"
                upgrade_firmwares
                ;;
            --fix)
                el_debug "Dispatching action: $arg"
                apt_fixes
                ;;
        esac
    done

}

#
#  MAIN
#
main "$@"

